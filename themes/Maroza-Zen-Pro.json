{
    "name": "Maroza Zen Pro",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "namespace": "#D4A574",
        "class": {
            "foreground": "#D4A574",
            "fontStyle": "bold"
        },
        "enum": "#D4A574",
        "interface": {
            "foreground": "#D4A574",
            "fontStyle": "bold"
        },
        "struct": "#D4A574",
        "typeParameter": "#7EB8C4",
        "type": "#D4A574",
        "parameter": {
            "foreground": "#C9A8D4",
            "fontStyle": "italic"
        },
        "variable": "#D4D4D4",
        "variable.constant": {
            "foreground": "#E8B87A"
        },
        "variable.defaultLibrary": {
            "foreground": "#D4A574"
        },
        "property": "#B8C4CE",
        "property.readonly": {
            "foreground": "#E8B87A"
        },
        "enumMember": {
            "foreground": "#7EB8C4"
        },
        "event": "#D4A574",
        "function": {
            "foreground": "#7EB8C4"
        },
        "method": {
            "foreground": "#7EB8C4"
        },
        "macro": "#C9A8D4",
        "label": "#E8987A",
        "comment": {
            "foreground": "#6B7D8A",
            "fontStyle": "italic"
        },
        "string": "#98C379",
        "keyword": {
            "foreground": "#9AADBD",
            "fontStyle": "bold"
        },
        "number": "#E8B87A",
        "regexp": "#7EB8C4",
        "operator": "#9AADBD",
        "decorator": "#D4A574",
        "selfParameter": {
            "foreground": "#D4A574",
            "fontStyle": "italic"
        },
        "builtinConstant": "#E8B87A",
        "magicFunction": "#7EB8C4",
        "escapeSequence": "#C9A8D4",
        "formatSpecifier": "#7EB8C4"
    },
    "tokenColors": [
        {
            "name": "Global - Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6B7D8A",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Global - Punctuation",
            "scope": [
                "punctuation",
                "meta.brace"
            ],
            "settings": {
                "foreground": "#8B9CAB"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.other.readwrite"
            ],
            "settings": {
                "foreground": "#D4D4D4"
            }
        },
        {
            "name": "Variable - Parameter",
            "scope": [
                "variable.parameter",
                "variable.parameter.function"
            ],
            "settings": {
                "foreground": "#C9A8D4",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Variable - Language (this, self)",
            "scope": [
                "variable.language",
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#D4A574",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.language",
                "support.constant"
            ],
            "settings": {
                "foreground": "#E8B87A"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float"
            ],
            "settings": {
                "foreground": "#E8B87A"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#98C379"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.expression"
            ],
            "settings": {
                "foreground": "#9AADBD",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.assignment"
            ],
            "settings": {
                "foreground": "#9AADBD"
            }
        },
        {
            "name": "Storage (let, const, var, function, class)",
            "scope": [
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#9AADBD",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "Classes & Types",
            "scope": [
                "entity.name.class",
                "entity.name.type",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#D4A574",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Interfaces & Type Parameters",
            "scope": [
                "entity.name.type.interface",
                "entity.name.type.parameter"
            ],
            "settings": {
                "foreground": "#D4A574"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.variable.property",
                "meta.property"
            ],
            "settings": {
                "foreground": "#B8C4CE"
            }
        },
        {
            "name": "Decorators & Annotations",
            "scope": [
                "entity.name.function.decorator",
                "meta.decorator",
                "punctuation.decorator"
            ],
            "settings": {
                "foreground": "#D4A574"
            }
        },
        {
            "name": "Tags (HTML/JSX/XML)",
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#E8987A"
            }
        },
        {
            "name": "Attributes",
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#D4A574",
                "fontStyle": "italic"
            }
        },
        {
            "name": "CSS - Selectors",
            "scope": [
                "entity.other.attribute-name.class.css",
                "entity.other.attribute-name.id.css",
                "entity.name.tag.css"
            ],
            "settings": {
                "foreground": "#D4A574"
            }
        },
        {
            "name": "CSS - Properties",
            "scope": [
                "support.type.property-name.css",
                "meta.property-name.css"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "CSS - Values",
            "scope": [
                "support.constant.property-value.css",
                "meta.property-value.css"
            ],
            "settings": {
                "foreground": "#E8B87A"
            }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "string.regexp",
                "constant.other.character-class.regexp"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "Escape Characters",
            "scope": [
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#C9A8D4"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#E8987A",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown - Headings",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown"
            ],
            "settings": {
                "foreground": "#D4A574",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown - Bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#E8B87A",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown - Italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#C9A8D4",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown - Links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "Markdown - Code",
            "scope": [
                "markup.inline.raw",
                "markup.fenced_code"
            ],
            "settings": {
                "foreground": "#98C379"
            }
        },
        {
            "name": "Markdown - Quote",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#6B7D8A",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Diff - Inserted",
            "scope": [
                "markup.inserted",
                "markup.inserted.diff"
            ],
            "settings": {
                "foreground": "#98C379"
            }
        },
        {
            "name": "Diff - Deleted",
            "scope": [
                "markup.deleted",
                "markup.deleted.diff"
            ],
            "settings": {
                "foreground": "#E8987A"
            }
        },
        {
            "name": "Diff - Changed",
            "scope": [
                "markup.changed",
                "markup.changed.diff"
            ],
            "settings": {
                "foreground": "#E8B87A"
            }
        },
        {
            "name": "JSON - Keys",
            "scope": [
                "support.type.property-name.json",
                "string.json.support.type.property-name"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "JSON - Values",
            "scope": [
                "string.value.json"
            ],
            "settings": {
                "foreground": "#98C379"
            }
        },
        {
            "name": "YAML - Keys",
            "scope": [
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "PHP Variables",
            "scope": [
                "variable.other.php",
                "punctuation.definition.variable.php"
            ],
            "settings": {
                "foreground": "#E8987A"
            }
        },
        {
            "name": "PHP Functions",
            "scope": [
                "entity.name.function.php",
                "support.function.php"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "Python - Self",
            "scope": [
                "variable.parameter.function.language.special.self.python"
            ],
            "settings": {
                "foreground": "#D4A574",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Python - Magic Methods",
            "scope": [
                "support.function.magic.python"
            ],
            "settings": {
                "foreground": "#7EB8C4"
            }
        },
        {
            "name": "Go - Package",
            "scope": [
                "entity.name.package.go"
            ],
            "settings": {
                "foreground": "#D4A574"
            }
        },
        {
            "name": "Rust - Lifetime",
            "scope": [
                "entity.name.lifetime.rust",
                "storage.modifier.lifetime.rust"
            ],
            "settings": {
                "foreground": "#C9A8D4",
                "fontStyle": "italic"
            }
        },
        {
            "name": "SQL - Keywords",
            "scope": [
                "keyword.other.sql"
            ],
            "settings": {
                "foreground": "#9AADBD",
                "fontStyle": "bold"
            }
        }
    ],
